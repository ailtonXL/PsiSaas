# Copie os valores para o gerenciador de segredos da hospedagem.
# A aplicação lê variáveis de ambiente; não carrega este arquivo automaticamente.
SECRET_KEY=
DATABASE=instance/psi.db
COOKIE_SECURE=0
TZ=America/Sao_Paulo
PUBLIC_BASE_URL=https://seu-dominio.example

# Gere DUAS chaves distintas com Fernet.generate_key(). Guarde-as fora do banco.
MFA_KEY=
BACKUP_KEY=

# Recuperação de senha e lembretes por e-mail (STARTTLS obrigatório).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Opcional: WhatsApp Business Cloud API, com template aprovado.
WA_PHONE_ID=
WA_ACCESS_TOKEN=
WA_TEMPLATE=

# Pix Mercado Pago. Uma conta recebedora por instalação nesta versão.
MP_OWNER_EMAIL=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
